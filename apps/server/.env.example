# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# Azure OpenAI — get these from your Azure portal > OpenAI resource > Keys and Endpoint
AZURE_ENDPOINT=https://your-resource.openai.azure.com
AZURE_API_KEY=your-azure-api-key
AZURE_API_VERSION=2024-12-01-preview
DEPLOYMENT_NAME=gpt-4o

# ScraperAPI — https://www.scraperapi.com/dashboard
SCRAPERAPI_KEY=your-scraperapi-key

# CORS — the URL your frontend runs on
FRONTEND_ORIGIN=http://localhost:5173

# Optional. When set, /metrics is exposed and gated by header `X-Admin-Secret: <value>`.
# Must be at least 8 chars. Leave unset in dev to disable /metrics.
# ADMIN_SECRET=
