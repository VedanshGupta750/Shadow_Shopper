{
  "name": "shadow-shopper",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:server",
    "dev:web": "npm run --workspace apps/web dev",
    "dev:server": "npm run --workspace apps/server dev",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,cjs}\"",
    "typecheck": "npm-run-all --parallel typecheck:server typecheck:web",
    "typecheck:server": "npm run --workspace apps/server typecheck",
    "typecheck:web": "npm run --workspace apps/web typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
